// Cloudflare Worker for the static demo shop demo-jewelry.jukto.bd.
// In Cloudflare: Project name = demo-jewelry, Advanced settings -> Path = deploy/jewelry,
// Build command empty, Deploy command "npx wrangler deploy".
{
  "name": "demo-jewelry",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/jewelry",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
