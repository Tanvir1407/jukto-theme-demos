// Cloudflare Worker for the static demo shop demo-generic.jukto.bd.
// In Cloudflare: Project name = demo-generic, Advanced settings -> Path = deploy/generic,
// Build command empty, Deploy command "npx wrangler deploy".
{
  "name": "demo-generic",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/generic",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
