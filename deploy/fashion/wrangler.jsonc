// Cloudflare Worker for the static demo shop demo-fashion.jukto.bd.
// In Cloudflare: Project name = demo-fashion, Advanced settings -> Path = deploy/fashion,
// Build command empty, Deploy command "npx wrangler deploy".
{
  "name": "demo-fashion",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/fashion",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
