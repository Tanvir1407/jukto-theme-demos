// Cloudflare Worker for the static demo shop demo-organic.jukto.bd.
// In Cloudflare: Project name = demo-organic, Advanced settings -> Path = deploy/organic,
// Build command empty, Deploy command "npx wrangler deploy".
{
  "name": "demo-organic",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/organic",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
