// Cloudflare Worker for the static demo shop demo-craft.jukto.bd.
// In Cloudflare: Project name = demo-craft, Advanced settings -> Path = deploy/craft,
// Build command empty, Deploy command "npx wrangler deploy".
{
  "name": "demo-craft",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/craft",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
