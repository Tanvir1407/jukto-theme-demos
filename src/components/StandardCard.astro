---
// Jukto StandardCard (Generic): 4:5 photo, soft corners, badges top-left, name, price and a small
// yellow "add" button (a product with more than one option opens its page instead).
import type { DemoProduct } from "../lib/types";
import { THEME_ID } from "../lib/shop";
import { bn, taka, img, offPercent } from "../lib/format";
import { t } from "../lib/i18n";
interface Props { p: DemoProduct; eager?: boolean }
const { p, eager } = Astro.props;
const o = p.options[0];
const off = offPercent(o.price, o.was);
const href = `/product/${p.slug}/`;
const many = p.options.length > 1;
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-xl bg-ink-0 border border-ink-200/70 hover:shadow-lg transition">
  <a href={href} class="relative block aspect-[4/5] overflow-hidden bg-ink-100">
    <img src={img(THEME_ID, p.img, 400)} srcset={`${img(THEME_ID, p.img, 400)} 400w, ${img(THEME_ID, p.img, 800)} 800w`} sizes="(max-width: 768px) 50vw, 25vw" alt={p.name} width="400" height="500" loading={eager ? "eager" : "lazy"} decoding="async" class="size-full object-cover transition duration-500 group-hover:scale-105" />
    <span class="absolute left-2 top-2 flex flex-col items-start gap-1">
      {off > 0 && <span class="rounded-md bg-action-500 px-2 py-0.5 text-xs font-bold text-ink-950">-{bn(off)}%</span>}
      {p.badge && <span class="rounded-md bg-heading px-2 py-0.5 text-xs font-semibold text-ink-0">{p.badge}</span>}
    </span>
  </a>
  <div class="flex flex-1 flex-col gap-1.5 p-3">
    <a href={href} class="line-clamp-2 text-sm leading-snug text-ink-800 hover:text-heading">{p.name}</a>
    <div class="mt-auto flex items-end justify-between gap-2">
      <span class="flex flex-col leading-tight">
        <span class="text-base font-bold text-heading">{taka(o.price)}</span>
        {o.was && <span class="text-xs text-ink-400 line-through">{taka(o.was)}</span>}
      </span>
      {many ? (
        <a href={href} class="grid place-items-center size-11 shrink-0 rounded-lg bg-action-500 text-ink-950 hover:bg-action-400" aria-label={`${p.name} — ${t("অপশন বাছুন")}`}>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h12l-1 13H7z M9 7a3 3 0 0 1 6 0"/></svg>
        </a>
      ) : (
        <button type="button" data-add={p.slug} data-opt="0" class="grid place-items-center size-11 shrink-0 rounded-lg bg-action-500 text-ink-950 hover:bg-action-400 active:scale-95 transition" aria-label={t("{name} কার্টে যোগ করুন", { name: p.name })}>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h12l-1 13H7z M9 7a3 3 0 0 1 6 0 M12 11v5 M9.5 13.5h5"/></svg>
        </button>
      )}
    </div>
  </div>
</article>
