---
// Jukto GroceryWideCard (E166, best sellers): photo left, Add (outline) + Buy now (filled).
import type { DemoProduct } from "../lib/types";
import { THEME_ID } from "../lib/shop";
import { bn, taka, img, offPercent } from "../lib/format";
interface Props { p: DemoProduct }
const { p } = Astro.props;
const o = p.options[0];
const off = offPercent(o.price, o.was);
const href = `/product/${p.slug}/`;
import { t } from "../lib/i18n";
---
<article class="group flex gap-3 md:gap-4 rounded-2xl border border-ink-100 bg-ink-0 p-2.5 md:p-3.5">
  <a href={href} class="relative block size-28 md:size-44 shrink-0 overflow-hidden rounded-xl bg-ink-50">
    <img src={img(THEME_ID, p.img, 400)} alt={p.name} width="400" height="400" loading="lazy" decoding="async" class="size-full object-cover" />
    {off > 0 && <span class="absolute left-2 top-2 rounded-full bg-action-500 px-2 py-0.5 text-xs font-bold text-ink-0">-{bn(off)}%</span>}
  </a>
  <div class="flex min-w-0 flex-1 flex-col gap-1.5">
    <span class="text-xs text-ink-500">{o.label}</span>
    <a href={href}><h3 class="line-clamp-2 text-sm md:text-lg font-semibold leading-snug text-ink-800 group-hover:text-brand-800">{p.name}</h3></a>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-base md:text-xl font-bold text-brand-800">{taka(o.price)}</span>
      {o.was && <span class="text-xs md:text-sm text-ink-400 line-through">{taka(o.was)}</span>}
      {o.was && <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-800">{t("{amount} সাশ্রয়", { amount: taka(o.was - o.price) })}</span>}
    </div>
    <div class="mt-auto grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
      <button type="button" data-add={p.slug} data-opt="0" class="h-11 rounded-full border-[1.5px] border-brand-800 text-sm font-semibold text-brand-800 hover:bg-brand-50">{t("কার্টে নিন")}</button>
      <button type="button" data-buy={p.slug} data-opt="0" class="h-11 rounded-full bg-brand-800 text-sm font-semibold text-ink-0 hover:bg-brand-900">{t("এখনই কিনুন")}</button>
    </div>
  </div>
</article>
