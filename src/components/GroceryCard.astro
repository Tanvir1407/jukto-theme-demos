---
// Jukto "grocery" card (E166): photo + badge, options or weight, 2-line name, price, saving,
// full-width rounded button. One option → adds to cart; more → "অপশন বাছুন" opens the product.
import type { DemoProduct } from "../lib/types";
import { THEME_ID } from "../lib/shop";
import { bn, taka, img, offPercent } from "../lib/format";
interface Props { p: DemoProduct; eager?: boolean }
const { p, eager } = Astro.props;
const o = p.options[0];
const off = offPercent(o.price, o.was);
const many = p.options.length > 1;
const href = `/product/${p.slug}/`;
import { t } from "../lib/i18n";
---
<article class="group flex h-full flex-col gap-1.5 md:gap-2 rounded-2xl border border-ink-100 bg-ink-0 p-2 md:p-3 hover:border-brand-200 hover:shadow-[0_6px_20px_-12px_rgba(15,36,24,0.35)] transition">
  <a href={href} class="relative block aspect-square overflow-hidden rounded-xl bg-ink-50">
    <img src={img(THEME_ID, p.img, 400)} srcset={`${img(THEME_ID, p.img, 400)} 400w, ${img(THEME_ID, p.img, 800)} 800w`} sizes="(max-width: 768px) 50vw, 20vw" alt={p.name} width="400" height="400" loading={eager ? "eager" : "lazy"} decoding="async" class="size-full object-cover transition duration-500 group-hover:scale-[1.04]" />
    {off > 0 && <span class="absolute left-2 top-2 rounded-full bg-action-500 px-2 py-0.5 text-xs font-bold text-ink-0">-{bn(off)}%</span>}
  </a>
  {many ? (
    <div class="flex flex-wrap gap-1">
      {p.options.slice(0, 3).map((x) => <span class="rounded-full border border-brand-200 px-2 py-px text-[11px] md:text-xs text-ink-700">{x.label}</span>)}
    </div>
  ) : (
    <span class="text-xs text-ink-500">{o.label}</span>
  )}
  <a href={href}><h3 class="line-clamp-2 min-h-10 md:min-h-11 text-sm md:text-[15px] font-semibold leading-snug text-ink-800 group-hover:text-brand-800">{p.name}</h3></a>
  <div class="flex flex-wrap items-baseline gap-x-2">
    <span class="text-base md:text-lg font-bold text-brand-800">{many ? t("{price} থেকে", { price: taka(o.price) }) : taka(o.price)}</span>
    {o.was && !many && <span class="text-xs text-ink-400 line-through">{taka(o.was)}</span>}
  </div>
  {o.was && !many ? <span class="self-start rounded-full bg-brand-50 px-2 py-0.5 text-[11px] md:text-xs font-semibold text-brand-800">{t("{amount} সাশ্রয়", { amount: taka(o.was - o.price) })}</span> : <span class="h-[22px]" aria-hidden="true"></span>}
  <div class="mt-auto pt-1">
    {many ? (
      <a href={href} class="flex h-11 w-full items-center justify-center gap-2 rounded-full bg-brand-800 text-sm font-semibold text-ink-0 hover:bg-brand-900">{t("অপশন বাছুন")}</a>
    ) : (
      <button type="button" data-add={p.slug} data-opt="0" class="flex h-11 w-full items-center justify-center gap-2 rounded-full bg-brand-800 text-sm font-semibold text-ink-0 hover:bg-brand-900 active:scale-[0.98] transition">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5h2l2 11h11l2-8H7"/><circle cx="9" cy="20" r="1"/><circle cx="17" cy="20" r="1"/></svg>{t("কার্টে নিন")}
      </button>
    )}
  </div>
</article>
