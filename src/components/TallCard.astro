---
// Jukto TallCard (Fashion, E138): 2:3 photo, square corners, badge top-left, centred name and price,
// colour swatches from the variants. "দ্রুত দেখুন" bar on hover (desktop) — here it opens the product.
import type { DemoProduct } from "../lib/types";
import { THEME_ID } from "../lib/shop";
import { bn, taka, img, offPercent } from "../lib/format";
interface Props { p: DemoProduct; eager?: boolean }
const { p, eager } = Astro.props;
const o = p.options[0];
const off = offPercent(o.price, o.was);
const href = `/product/${p.slug}/`;
import { t } from "../lib/i18n";
---
<article class="group h-full">
  <a href={href} class="flex h-full flex-col bg-ink-0 border border-ink-100/70 hover:shadow-md transition">
    <div class="relative aspect-[2/3] overflow-hidden bg-ink-50">
      <img src={img(THEME_ID, p.img, 400)} srcset={`${img(THEME_ID, p.img, 400)} 400w, ${img(THEME_ID, p.img, 800)} 800w`} sizes="(max-width: 768px) 50vw, 25vw" alt={p.name} width="400" height="600" loading={eager ? "eager" : "lazy"} decoding="async" class="size-full object-cover transition duration-700 ease-out group-hover:scale-105" />
      <div class="absolute left-2 top-2 flex flex-col items-start gap-1">
        {p.badge && <span class="bg-ink-900 px-2 py-0.5 text-xs font-semibold text-ink-0">{p.badge}</span>}
        {off > 0 && <span class="bg-action-500 px-2 py-0.5 text-xs font-semibold text-ink-950">{t("{n}% ছাড়", { n: bn(off) })}</span>}
      </div>
      <span class="absolute inset-x-2 bottom-2 hidden md:flex items-center justify-center gap-1.5 bg-ink-950/90 py-2 text-xs font-semibold text-ink-0 opacity-0 group-hover:opacity-100 transition">{t("দ্রুত দেখুন")}</span>
    </div>
    <div class="flex flex-1 flex-col items-center gap-1 p-3 text-center">
      <h3 class="line-clamp-2 text-[13px] md:text-sm text-ink-800 leading-snug">{p.name}</h3>
      <div class="flex items-baseline gap-2">
        <span class="text-sm font-semibold text-ink-950">{taka(o.price)}</span>
        {o.was && <span class="text-xs text-ink-400 line-through">{taka(o.was)}</span>}
      </div>
      {p.colors && p.colors.length > 0 && (
        <span class="mt-0.5 flex items-center gap-1.5" aria-label={t("{n}টি রং", { n: bn(p.colors.length) })}>
          {p.colors.slice(0, 4).map((c) => <span class="keep-round size-3 rounded-full border border-ink-200" style={`background:${c}`}></span>)}
        </span>
      )}
    </div>
  </a>
</article>
