---
// Home page. The top area and the order of the sections come from the theme (as Jukto's
// ThemeBlocks.top and THEMES[id].home); a section with no data renders nothing.
import Layout from "../layouts/Layout.astro";
import Panel from "../components/Panel.astro";
import ProductCard from "../components/ProductCard.astro";
import WideCard from "../components/WideCard.astro";
import { shop, theme, THEME_ID, productsIn, href, bigSize } from "../lib/shop";
import { img, bn } from "../lib/format";

const flash = shop.products.filter((p) => p.flash);
const best = shop.products.filter((p) => p.best);
const fresh = shop.products.filter((p) => p.badge).concat(shop.products.filter((p) => !p.badge)).slice(0, 8);
// Luxe (Jewellery) shows best sellers in their own row, so "new" leaves them out.
const freshLuxe = shop.products.filter((p) => !p.best && p.badge).concat(shop.products.filter((p) => !p.best && !p.badge)).slice(0, 8);
const rows = shop.categories.filter((c) => productsIn(c.id).length >= 3);
const b = theme.blocks;
const grid = b.card !== "grocery" ? "grid grid-cols-2 lg:grid-cols-4 gap-2.5 md:gap-5" : "grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2.5 md:gap-4";
const perRow = b.card !== "grocery" ? 4 : 5;
// "trending" (Generic): one tab per category with products, plus "সব".
const trendCats = shop.categories.filter((c) => productsIn(c.id).length > 0);
import { t } from "../lib/i18n";
---
<Layout active="home">
  {b.top === "categoryRail" ? (
    <section aria-label={t("অফার")} class="mx-auto max-w-7xl px-3 md:px-6 pt-3 md:pt-5 grid gap-3 md:gap-5 lg:grid-cols-[240px_1fr_300px]">
      <nav aria-label={t("সব ক্যাটাগরি")} class="hidden lg:flex flex-col rounded-2xl bg-ink-0 p-2">
        {shop.categories.map((c) => (
          <a href={`/products/?category=${c.id}`} class="flex items-center gap-3 h-12 px-2.5 rounded-xl text-[15px] text-ink-800 hover:bg-brand-50 hover:text-brand-800">
            <img src={img(THEME_ID, c.img, 400)} alt="" width="32" height="32" class="size-8 rounded-lg object-cover" />
            <span class="flex-1">{c.name}</span>
            <span aria-hidden="true" class="text-ink-400">›</span>
          </a>
        ))}
      </nav>
      <div class="relative overflow-hidden rounded-2xl md:rounded-3xl bg-brand-950" data-slider>
        <div class="flex snap-x snap-mandatory overflow-x-auto no-scrollbar" data-track>
          {shop.slides.map((s, i) => (
            <a href={href(s.href)} class="relative block w-full shrink-0 snap-start aspect-[16/10] md:aspect-auto md:h-[420px]">
              <img src={img(THEME_ID, s.img, 1600)} srcset={`${img(THEME_ID, s.img, 800)} 800w, ${img(THEME_ID, s.img, 1600)} 1600w`} sizes="(max-width: 1024px) 100vw, 60vw" alt="" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} class="absolute inset-0 size-full object-cover" />
              <span class="absolute inset-0 bg-gradient-to-r from-brand-950/85 via-brand-950/45 to-transparent"></span>
              <span class="relative flex h-full max-w-[78%] md:max-w-[52%] flex-col justify-center gap-2 md:gap-4 p-5 md:p-10">
                {s.badge && <span class="self-start rounded-full bg-ink-0 px-3 py-1 text-xs md:text-sm font-semibold text-brand-800">{s.badge}</span>}
                <span class="text-2xl md:text-[42px] font-bold leading-tight text-ink-0">{s.title}</span>
                <span class="hidden sm:block text-sm md:text-lg leading-relaxed text-ink-0/85">{s.text}</span>
                <span class="mt-1 self-start rounded-full bg-action-500 px-5 md:px-7 h-10 md:h-12 flex items-center text-sm md:text-base font-semibold text-ink-0">{s.cta}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="absolute bottom-3 md:bottom-5 left-5 md:left-10 flex gap-1.5" data-dots>
          {shop.slides.map((_, i) => <button type="button" aria-label={t("স্লাইড {n}", { n: bn(i + 1) })} class="keep-round h-1.5 w-1.5 rounded-full bg-ink-0/50 transition-all data-[on='1']:w-6 data-[on='1']:bg-ink-0" data-on={i === 0 ? "1" : ""}></button>)}
        </div>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-1 gap-3 md:gap-5">
        {shop.tiles.map((tile) => (
          <a href={href(tile.href)} class="group relative overflow-hidden rounded-2xl md:rounded-3xl min-h-32 lg:min-h-0 flex flex-col justify-end gap-0.5 p-4 md:p-5 bg-brand-950">
            <img src={img(THEME_ID, tile.img, 800)} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105" />
            <span class="absolute inset-0 bg-gradient-to-t from-brand-950/85 to-transparent"></span>
            <span class="relative text-xs md:text-sm font-semibold text-action-100">{tile.eyebrow}</span>
            <span class="relative text-base md:text-xl font-bold leading-snug text-ink-0">{tile.title}</span>
          </a>
        ))}
      </div>
    </section>
  ) : b.top === "boxed" ? (
    <section aria-label={t("অফার")} class="mx-auto max-w-7xl px-3 md:px-6 pt-3 md:pt-6">
      <div class="relative overflow-hidden rounded-2xl bg-heading" data-slider>
        <div class="flex snap-x snap-mandatory overflow-x-auto no-scrollbar" data-track>
          {shop.slides.map((s, i) => (
            <a href={href(s.href)} class="relative block w-full shrink-0 snap-start aspect-[4/3] sm:aspect-[16/7] md:aspect-auto md:h-[440px]">
              <img src={img(THEME_ID, s.img, 1600)} srcset={`${img(THEME_ID, s.img, 800)} 800w, ${img(THEME_ID, s.img, 1600)} 1600w`} sizes="(max-width: 1280px) 100vw, 1232px" alt="" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} class="absolute inset-0 size-full object-cover" />
              <span class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-ink-950/80 via-ink-950/40 to-transparent"></span>
              <span class="relative flex h-full max-w-xl flex-col justify-end sm:justify-center gap-2 md:gap-4 p-5 pb-10 md:p-12">
                {s.badge && <span class="self-start rounded-md bg-action-500 px-2.5 py-1 text-xs md:text-sm font-bold text-ink-950">{s.badge}</span>}
                <span class="text-2xl md:text-5xl font-bold leading-tight text-ink-0">{s.title}</span>
                <span class="hidden sm:block text-sm md:text-lg leading-relaxed text-ink-0/85">{s.text}</span>
                <span class="mt-1 self-start h-11 md:h-12 px-6 rounded-lg bg-ink-0 flex items-center text-sm md:text-base font-semibold text-heading">{s.cta}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="absolute bottom-3 md:bottom-5 left-5 md:left-12 flex gap-1.5" data-dots>
          {shop.slides.map((_, i) => <button type="button" aria-label={t("স্লাইড {n}", { n: bn(i + 1) })} class="keep-round h-1.5 w-1.5 rounded-full bg-ink-0/50 transition-all data-[on='1']:w-6 data-[on='1']:bg-ink-0" data-on={i === 0 ? "1" : ""}></button>)}
        </div>
      </div>
    </section>
  ) : b.top === "split" ? (
    <section aria-label={t("অফার")} class="mx-auto max-w-7xl md:px-6 grid md:grid-cols-2 md:min-h-[600px]">
      {shop.slides.slice(0, 1).map((s) => (
        <>
          <div class="order-2 md:order-1 flex flex-col justify-center gap-4 md:gap-6 px-5 py-10 md:py-20 md:pr-14 md:pl-0">
            {s.badge && <span class="text-xs tracking-[0.3em] uppercase text-brand-800">{s.badge}</span>}
            <h1 class="text-4xl md:text-[60px] leading-[1.1] text-heading">{s.title}</h1>
            <p class="max-w-md text-base md:text-lg leading-relaxed text-ink-600">{s.text}</p>
            <span class="mt-2 flex flex-wrap gap-3">
              <a href={href(s.href)} class="h-12 md:h-14 px-7 flex items-center bg-brand-800 text-sm md:text-[15px] font-semibold text-surface hover:bg-brand-900">{s.cta}</a>
              <a href="/products/?sale=1" class="h-12 md:h-14 px-6 flex items-center border border-ink-300 text-sm md:text-[15px] text-heading hover:border-brand-800">{t("অফার")}</a>
            </span>
          </div>
          <img src={img(THEME_ID, s.img, 800)} alt="" fetchpriority="high" class="order-1 md:order-2 w-full aspect-[4/5] md:aspect-auto md:h-full object-cover" />
        </>
      ))}
    </section>
  ) : (
    <section aria-label={t("অফার")} class="relative overflow-hidden bg-heading" data-slider>
      <div class="flex snap-x snap-mandatory overflow-x-auto no-scrollbar" data-track>
        {shop.slides.map((s, i) => (
          <a href={href(s.href)} class="relative block w-full shrink-0 snap-start h-[520px] md:h-[640px]">
            <img src={img(THEME_ID, s.img, 1600)} srcset={`${img(THEME_ID, s.img, 800)} 800w, ${img(THEME_ID, s.img, 1600)} 1600w`} sizes="100vw" alt="" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} class="absolute inset-0 size-full object-cover object-[70%_center] md:object-center" />
            <span class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-ink-950/80 via-ink-950/35 to-transparent"></span>
            <span class="relative mx-auto flex h-full max-w-7xl flex-col justify-end md:justify-center gap-3 md:gap-5 px-5 md:px-6 pb-14 md:pb-0">
              {s.badge && <span class="text-xs md:text-sm font-semibold text-ink-0/90">{s.badge}</span>}
              <span class="max-w-xl text-4xl md:text-6xl font-semibold leading-[1.1] text-ink-0">{s.title}</span>
              <span class="max-w-md text-sm md:text-lg leading-relaxed text-ink-0/85">{s.text}</span>
              <span class="mt-1 flex gap-3">
                <span class="h-12 px-6 flex items-center bg-ink-0 text-sm font-semibold text-heading">{s.cta}</span>
              </span>
            </span>
          </a>
        ))}
      </div>
      <div class="absolute bottom-5 inset-x-0 mx-auto max-w-7xl px-5 md:px-6 flex gap-1.5" data-dots>
        {shop.slides.map((_, i) => <button type="button" aria-label={t("স্লাইড {n}", { n: bn(i + 1) })} class="keep-round h-1.5 w-1.5 rounded-full bg-ink-0/50 transition-all data-[on='1']:w-6 data-[on='1']:bg-ink-0" data-on={i === 0 ? "1" : ""}></button>)}
      </div>
    </section>
  )}

  {shop.home.map((section) => {
    if (section === "highlights")
      return b.sections === "panels" ? (
        <section aria-label={t("কেন আমাদের থেকে কিনবেন")} class="mx-3 xl:mx-auto max-w-7xl mt-3 md:mt-5 rounded-2xl bg-ink-0 p-3.5 md:p-5 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
          {shop.highlights.map((h) => (
            <div class="flex items-center gap-3">
              <span class="grid place-items-center size-11 md:size-12 shrink-0 rounded-xl bg-brand-50 text-lg font-bold text-brand-800">{h.mark}</span>
              <span class="flex flex-col leading-tight"><span class="text-sm md:text-base font-semibold text-heading">{h.title}</span><span class="text-xs md:text-sm text-ink-500">{h.sub}</span></span>
            </div>
          ))}
        </section>
      ) : (
        <section aria-label={t("কেন আমাদের থেকে কিনবেন")} class="mx-auto max-w-7xl px-3 md:px-6 mt-12 md:mt-16">
          <div class="grid grid-cols-2 md:grid-cols-4 border-y border-ink-200">
            {shop.highlights.map((h) => (
              <div class="flex flex-col items-center gap-0.5 py-5 px-2 text-center">{theme.displayFont && <span class="keep-round mb-2 grid size-12 md:size-14 place-items-center rounded-full border border-brand-800 font-display text-base text-brand-800">{h.mark}</span>}<span class="text-sm font-semibold text-heading">{h.title}</span><span class="text-xs text-ink-500">{h.sub}</span></div>
            ))}
          </div>
        </section>
      );

    if (section === "categories" && b.categories === "arch")
      return (
        <section aria-labelledby="cats" class="mx-auto max-w-7xl px-3 md:px-6 pt-14 md:pt-24">
          <div class="mb-8 md:mb-11 flex flex-col items-center gap-3 text-center">
            <span class="text-xs tracking-[0.3em] uppercase text-brand-800">{t("কালেকশন")}</span>
            <h2 id="cats" class="text-3xl md:text-[44px] leading-tight text-heading">{t("ক্যাটাগরি অনুযায়ী দেখুন")}</h2>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            {shop.categories.map((c) => (
              <a href={`/products/?category=${c.id}`} class="group flex flex-col items-center gap-2 md:gap-3 text-center">
                <span class="keep-round block w-full aspect-[3/4] overflow-hidden rounded-t-full border border-ink-200 bg-ink-50 group-hover:border-brand-800 transition">
                  <img src={img(THEME_ID, c.img, 800)} alt="" width="800" height="1200" loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-105" />
                </span>
                <span class="font-display text-xl md:text-2xl text-heading">{c.name}</span>
                <span class="-mt-1 text-xs md:text-sm text-ink-600">{t("{n}টি ডিজাইন", { n: bn(productsIn(c.id).length) })}</span>
              </a>
            ))}
          </div>
        </section>
      );

    if (section === "categories" && b.categories === "circles")
      return (
        <Panel title={t("ক্যাটাগরি")} id="cats" href="/products/">
          <div class="flex justify-start md:justify-center gap-5 md:gap-12 overflow-x-auto no-scrollbar -mx-3 px-3 md:mx-0 md:px-0">
            {shop.categories.map((c) => (
              <a href={`/products/?category=${c.id}`} class="group flex w-20 md:w-36 shrink-0 flex-col items-center gap-2 text-center">
                <span class="keep-round block size-20 md:size-36 overflow-hidden rounded-full bg-ink-100 ring-1 ring-ink-200 group-hover:ring-2 group-hover:ring-heading transition">
                  <img src={img(THEME_ID, c.img, 400)} alt="" width="400" height="400" loading="lazy" class="size-full object-cover transition duration-500 group-hover:scale-110" />
                </span>
                <span class="text-sm md:text-base font-semibold text-heading">{c.name}</span>
                <span class="-mt-1.5 text-xs text-ink-500">{t("{n}টি পণ্য", { n: bn(productsIn(c.id).length) })}</span>
              </a>
            ))}
          </div>
        </Panel>
      );

    if (section === "trending")
      return (
        <Panel title={t("জনপ্রিয় পণ্য")} id="trending" href="/products/">
          <div data-tabs>
            <div role="tablist" aria-label={t("ক্যাটাগরি বাছুন")} class="mb-4 md:mb-6 flex gap-2 overflow-x-auto no-scrollbar -mx-3 px-3 md:mx-0 md:px-0">
              {[{ id: "all", name: t("সব") }, ...trendCats].map((c, i) => (
                <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-tab={c.id} class="shrink-0 h-10 px-4 rounded-lg border border-ink-200 bg-ink-0 text-sm font-medium text-ink-700 hover:border-heading aria-selected:bg-heading aria-selected:border-heading aria-selected:text-ink-0">{c.name}</button>
              ))}
            </div>
            {[{ id: "all" }, ...trendCats].map((c, i) => (
              <div role="tabpanel" data-panel={c.id} hidden={i !== 0} class={grid}>
                {(c.id === "all" ? best.concat(shop.products.filter((p) => !p.best)) : productsIn(c.id)).slice(0, 8).map((p, j) => <ProductCard p={p} eager={i === 0 && j < 2} />)}
              </div>
            ))}
          </div>
        </Panel>
      );

    if (section === "categories")
      return b.categories === "photoTiles" ? (
        <Panel title={t("ক্যাটাগরি অনুযায়ী কিনুন")} id="cats" href="/products/">
          <div class="grid grid-cols-4 md:grid-cols-7 gap-x-2 gap-y-4 md:gap-4">
            {shop.categories.map((c) => (
              <a href={`/products/?category=${c.id}`} class="group flex flex-col items-center gap-1.5 text-center">
                <span class="block w-full aspect-square rounded-2xl bg-brand-50 p-1.5 md:p-2.5">
                  <img src={img(THEME_ID, c.img, 400)} alt="" width="400" height="400" loading="lazy" class="size-full rounded-xl object-cover transition duration-500 group-hover:scale-105" />
                </span>
                <span class="line-clamp-2 text-xs md:text-sm font-semibold leading-tight text-heading group-hover:text-brand-800">{c.name}</span>
              </a>
            ))}
          </div>
        </Panel>
      ) : (
        <Panel title={t("ক্যাটাগরি অনুযায়ী কিনুন")} id="cats">
          <div class="flex md:grid md:grid-cols-5 gap-2.5 md:gap-4 overflow-x-auto no-scrollbar -mx-3 px-3 md:mx-0 md:px-0">
            {shop.categories.map((c) => (
              <a href={`/products/?category=${c.id}`} class="group w-[38%] shrink-0 md:w-auto flex flex-col gap-2">
                <span class="block aspect-[3/4] overflow-hidden bg-ink-100"><img src={img(THEME_ID, c.img, 400)} alt="" width="400" height="600" loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-105" /></span>
                <span class="text-sm text-heading">{c.name}</span>
              </a>
            ))}
          </div>
        </Panel>
      );

    if (section === "campaign" && shop.campaign && flash.length > 0)
      return (
        <Panel title={shop.campaign.title} id="flash" href="/products/?sale=1">
          <span slot="badge" class="shrink-0 rounded-full bg-action-50 px-3 py-1 text-xs md:text-sm font-bold tabular-nums text-action-800" data-countdown={shop.campaign.endsInHours}>{t("শেষ হবে —")}</span>
          <div class={grid}>{flash.slice(0, perRow).map((p, i) => <ProductCard p={p} eager={i < 2} />)}</div>
        </Panel>
      );

    if (section === "best" && best.length > 0 && b.card === "luxe")
      return (
        <Panel title={t("সবচেয়ে প্রিয়")} id="best" href="/products/">
          <div class={grid}>{best.slice(0, 4).map((p, i) => <ProductCard p={p} eager={i < 2} />)}</div>
        </Panel>
      );

    if (section === "best" && best.length > 0)
      return (
        <Panel title={t("সবচেয়ে বেশি বিক্রি")} id="best" href="/products/">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 md:gap-4">{best.slice(0, 6).map((p) => <WideCard p={p} />)}</div>
        </Panel>
      );

    if (section === "rows")
      return rows.map((c) => (
        <Panel title={c.name} id={`row-${c.id}`} href={`/products/?category=${c.id}`}>
          <div class={grid}>{productsIn(c.id).slice(0, perRow).map((p) => <ProductCard p={p} />)}</div>
        </Panel>
      ));

    if (section === "newArrivals")
      return (
        <Panel title={t("নতুন এসেছে")} id="new" href="/products/">
          <div class={grid}>{(b.card === "luxe" ? freshLuxe : fresh).map((p, i) => <ProductCard p={p} eager={i < 2} />)}</div>
        </Panel>
      );

    if (section === "collections" && shop.collections?.length)
      return (
        <Panel title={t("কালেকশন")} id="collections">
          <div class="flex md:grid md:grid-cols-3 gap-3 md:gap-5 overflow-x-auto no-scrollbar -mx-3 px-3 md:mx-0 md:px-0">
            {shop.collections.map((c) => (
              <a href={href(c.href)} class="group w-[72%] shrink-0 md:w-auto flex flex-col gap-3">
                <span class="block aspect-[4/5] overflow-hidden bg-ink-100"><img src={img(THEME_ID, c.img, 800)} alt="" width="800" height="1000" loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-105" /></span>
                <span class="flex items-baseline justify-between gap-3"><span class="text-xl md:text-2xl text-heading">{c.title}</span>{c.note && <span class="text-xs md:text-sm text-ink-500">{c.note} →</span>}</span>
              </a>
            ))}
          </div>
        </Panel>
      );

    if (section === "story" && shop.story)
      return (
        <section aria-labelledby="story" class="mx-auto max-w-7xl px-3 md:px-6 pt-10 md:pt-16">
          <div data-story-panel class="grid md:grid-cols-[3fr_2fr] bg-ink-100">
            <img src={img(THEME_ID, shop.story.img, bigSize(shop.story.img))} alt="" loading="lazy" class:list={["w-full object-cover", bigSize(shop.story.img) === 1600 ? "aspect-[16/10] md:aspect-auto md:h-full" : "aspect-[4/5] md:aspect-auto md:h-[560px] object-[center_20%]"]} />
            <div class="flex flex-col justify-center gap-3 md:gap-4 p-6 md:p-12">
              <span class="text-xs font-semibold text-action-800">{shop.story.eyebrow}</span>
              <h2 id="story" class="text-2xl md:text-[34px] font-semibold leading-tight text-heading">{shop.story.title}</h2>
              <p class="leading-relaxed text-ink-600">{shop.story.text}</p>
              <a href={href(shop.story.href)} class="mt-1 self-start h-11 px-5 flex items-center border border-heading text-sm font-semibold text-heading hover:bg-heading hover:text-ink-0">{shop.story.cta}</a>
            </div>
          </div>
        </section>
      );
    return null;
  })}
</Layout>

<script>
  const UI = JSON.parse(document.getElementById("demo-data")?.textContent || "{}");
  const BN = "০১২৩৪৫৬৭৮৯";
  const two = (n: number) => { const s = String(n).padStart(2, "0"); return UI.lang === "en" ? s : s.replace(/\d/g, (d) => BN[+d]); };
  document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((el) => {
    const end = Date.now() + Number(el.dataset.countdown) * 3600_000 - 7 * 60_000;
    const tick = () => {
      const s = Math.max(0, Math.floor((end - Date.now()) / 1000));
      el.textContent = UI.ui.endsIn.replace("{time}", `${two(Math.floor(s / 3600))}:${two(Math.floor((s % 3600) / 60))}:${two(s % 60)}`);
    };
    tick();
    setInterval(tick, 1000);
  });

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>("[data-tab]")];
    tabs.forEach((t) => t.addEventListener("click", () => {
      tabs.forEach((x) => x.setAttribute("aria-selected", x === t ? "true" : "false"));
      root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== t.dataset.tab));
    }));
  });

  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const dots = [...root.querySelectorAll<HTMLElement>("[data-dots] button")];
    const go = (i: number) => track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" });
    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
    track.addEventListener("scroll", () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, j) => (d.dataset.on = i === j ? "1" : ""));
    }, { passive: true });
    if (dots.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(() => go((Math.round(track.scrollLeft / track.clientWidth) + 1) % dots.length), 5000);
    }
  });
</script>
