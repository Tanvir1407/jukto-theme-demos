---
import Layout from "../layouts/Layout.astro";
import { t } from "../lib/i18n";
---
<Layout title={t("পাতা পাওয়া যায়নি")}>
  <div class="mx-auto max-w-md px-4 py-20 text-center">
    <h1 class="text-2xl font-bold text-heading">{t("এই পাতাটি পাওয়া যায়নি")}</h1>
    <a href="/" class="mt-6 inline-flex h-11 items-center rounded-full bg-brand-800 px-6 font-semibold text-ink-0">{t("হোমে ফিরুন")}</a>
  </div>
</Layout>
