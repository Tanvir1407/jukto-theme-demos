---
import Layout from "../../layouts/Layout.astro";
const steps = [
  { t: t("অর্ডার পাওয়া গেছে"), d: t("আজ সকাল ১০:১২") },
  { t: t("কনফার্ম হয়েছে"), d: t("আজ সকাল ১০:৩০") },
  { t: t("প্যাক হচ্ছে"), d: t("আজ দুপুর ১২:০৫") },
  { t: t("ডেলিভারিতে দেওয়া হবে"), d: "" },
];
import { t } from "../../lib/i18n";
---
<Layout title={t("অর্ডার ট্র্যাক")} active="track">
  <div class="mx-auto max-w-xl px-3 md:px-6 pt-4 md:pt-8">
    <h1 class="text-2xl md:text-3xl font-bold text-heading">{t("অর্ডার ট্র্যাক করুন")}</h1>
    <form id="track-form" class="mt-4 flex gap-2 rounded-2xl bg-ink-0 p-3">
      <label for="oid" class="sr-only">{t("অর্ডার নম্বর বা মোবাইল")}</label>
      <input id="oid" required placeholder={t("অর্ডার নম্বর বা মোবাইল নম্বর")} class="h-12 min-w-0 flex-1 rounded-full border border-ink-200 px-4 outline-none focus:border-brand-800" />
      <button class="h-12 rounded-full bg-brand-800 px-6 font-semibold text-ink-0">{t("দেখুন")}</button>
    </form>
    <section id="track-result" hidden class="mt-4 rounded-2xl bg-ink-0 p-5">
      <p class="text-sm text-ink-500">{t("নমুনা অর্ডার · ডেমো দোকানে আসল অর্ডার নেই")}</p>
      <ol class="mt-4 flex flex-col">
        {steps.map((s, i) => (
          <li class="relative flex gap-3 pb-6 last:pb-0">
            <span class:list={["relative z-10 mt-0.5 grid size-6 shrink-0 place-items-center rounded-full text-xs font-bold", i < 3 ? "bg-brand-800 text-ink-0" : "border-2 border-ink-300 bg-ink-0"]}>{i < 3 ? "✓" : ""}</span>
            {i < steps.length - 1 && <span class:list={["absolute left-[11px] top-6 h-full w-0.5", i < 2 ? "bg-brand-800" : "bg-ink-200"]}></span>}
            <span class="flex flex-col"><span class:list={["font-semibold", i < 3 ? "text-heading" : "text-ink-500"]}>{s.t}</span>{s.d && <span class="text-sm text-ink-500">{s.d}</span>}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
<script>
  document.getElementById("track-form")!.addEventListener("submit", (e) => {
    e.preventDefault();
    document.getElementById("track-result")!.hidden = false;
  });
</script>
