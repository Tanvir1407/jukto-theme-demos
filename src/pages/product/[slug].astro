---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { shop, theme, THEME_ID, categoryName, productsIn } from "../../lib/shop";
import { bn, taka, img, offPercent } from "../../lib/format";
import type { DemoProduct } from "../../lib/types";

export function getStaticPaths() {
  return shop.products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: DemoProduct };
const first = p.options[0];
const tall = theme.blocks.card === "tall";
const standard = theme.blocks.card === "standard";
const related = productsIn(p.category).filter((x) => x.slug !== p.slug).concat(shop.products.filter((x) => x.category !== p.category && x.best)).slice(0, 5);
import { t } from "../../lib/i18n";
---
<Layout title={p.name} active="categories">
  <div class="mx-auto max-w-7xl px-3 md:px-6 pt-4 md:pt-6">
    <nav aria-label={t("অবস্থান")} class="text-sm text-ink-500 truncate">
      <a href="/" class="hover:text-brand-800">{t("হোম")}</a> / <a href={`/products/?category=${p.category}`} class="hover:text-brand-800">{categoryName(p.category)}</a> / <span class="text-ink-800">{p.name}</span>
    </nav>
    <div class="mt-3 md:mt-5 grid gap-5 md:gap-10 md:grid-cols-2 rounded-2xl bg-ink-0 p-3 md:p-8" data-buy-box>
      <div class:list={["relative overflow-hidden rounded-2xl bg-ink-50", tall ? "aspect-[2/3] md:max-h-[720px] md:aspect-auto md:h-full" : standard ? "aspect-[4/5]" : "aspect-square"]}>
        <img src={img(THEME_ID, p.img, 800)} alt={p.name} width="800" height={tall ? 1200 : standard ? 1000 : 800} fetchpriority="high" class="size-full object-cover" />
        {offPercent(first.price, first.was) > 0 && <span class="absolute left-3 top-3 rounded-full bg-action-500 px-3 py-1 text-sm font-bold text-ink-0">-{bn(offPercent(first.price, first.was))}%</span>}
      </div>
      <div class="flex flex-col gap-4">
        <span class="self-start rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800">{categoryName(p.category)}</span>
        <h1 class="text-2xl md:text-3xl font-bold leading-snug text-heading">{p.name}</h1>
        <div class="flex items-baseline gap-3">
          <span class="text-3xl font-bold text-brand-800" data-price>{taka(first.price)}</span>
          <span class="text-base text-ink-400 line-through" data-was hidden={!first.was}>{first.was ? taka(first.was) : ""}</span>
        </div>
        <fieldset class="flex flex-col gap-2">
          <legend class="mb-2 text-sm font-semibold text-ink-700">{t(tall || theme.blocks.card === "luxe" ? "সাইজ বাছুন" : standard ? "অপশন বাছুন" : "পরিমাণ বাছুন")}</legend>
          <div class="flex flex-wrap gap-2">
            {p.options.map((o, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="opt" value={i} checked={i === 0} class="peer sr-only" data-p={o.price} data-w={o.was ?? ""} />
                <span class="flex h-11 items-center rounded-full border-[1.5px] border-ink-200 px-5 text-sm font-semibold text-ink-700 peer-checked:border-brand-800 peer-checked:bg-brand-50 peer-checked:text-brand-900 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-400">{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="flex items-center gap-3">
          <span class="text-sm font-semibold text-ink-700">{t("সংখ্যা")}</span>
          <div class="flex items-center rounded-full border border-ink-200">
            <button type="button" data-step="-1" aria-label={t("কমান")} class="size-11 text-xl text-brand-800">−</button>
            <span class="min-w-8 text-center font-semibold" data-qty-value data-value="1">{t("১")}</span>
            <button type="button" data-step="1" aria-label={t("বাড়ান")} class="size-11 text-xl text-brand-800">+</button>
          </div>
        </div>
        <div class="hidden md:grid grid-cols-2 gap-3 pt-1">
          <button type="button" data-add={p.slug} class="h-12 rounded-full border-[1.5px] border-brand-800 font-semibold text-brand-800 hover:bg-brand-50">{t("কার্টে নিন")}</button>
          <button type="button" data-buy={p.slug} class="h-12 rounded-full bg-brand-800 font-semibold text-ink-0 hover:bg-brand-900">{t("এখনই কিনুন")}</button>
        </div>
        <ul class="grid gap-2 rounded-2xl bg-surface p-4 text-sm text-ink-700">
          <li>🚚 {t("ঢাকায় ডেলিভারি {a}, বাইরে {b}", { a: taka(shop.delivery.inside), b: taka(shop.delivery.outside) })}{shop.delivery.freeOver ? ` · ${t("{n}+ অর্ডারে ফ্রি", { n: taka(shop.delivery.freeOver) })}` : ""}</li>
          <li>{t("💵 ক্যাশ অন ডেলিভারি — হাতে পেয়ে টাকা দিন")}</li>
          <li>{t("↩️ খাঁটি না হলে ডেলিভারির সময়েই ফেরত")}</li>
        </ul>
        <div>
          <h2 class="mb-1.5 text-base font-bold text-heading">{t("বিবরণ")}</h2>
          <p class="leading-relaxed text-ink-700">{p.text}</p>
        </div>
      </div>
      <div class="md:hidden fixed inset-x-0 bottom-[68px] z-30 grid grid-cols-2 gap-2 border-t border-ink-200 bg-ink-0 p-2.5">
        <button type="button" data-add={p.slug} class="h-12 rounded-full border-[1.5px] border-brand-800 font-semibold text-brand-800">{t("কার্টে নিন")}</button>
        <button type="button" data-buy={p.slug} class="h-12 rounded-full bg-brand-800 font-semibold text-ink-0">{t("এখনই কিনুন")}</button>
      </div>
    </div>
    <section aria-labelledby="rel" class="mt-5 md:mt-8 mb-20 md:mb-0">
      <h2 id="rel" class="mb-3 md:mb-4 text-xl md:text-2xl font-bold text-heading">{t("আরও দেখুন")}</h2>
      <div class:list={["grid grid-cols-2 gap-2.5 md:gap-4", tall || standard ? "lg:grid-cols-4" : "sm:grid-cols-3 lg:grid-cols-5"]}>{related.slice(0, tall || standard ? 4 : 5).map((x) => <ProductCard p={x} />)}</div>
    </section>
  </div>
</Layout>

<script>
  const UI = JSON.parse(document.getElementById("demo-data")?.textContent || "{}");
  const BN = "০১২৩৪৫৬৭৮৯";
  const bn = (n: number) => (UI.lang === "en" ? n.toLocaleString("en-US") : n.toLocaleString("en-US").replace(/\d/g, (d) => BN[+d]));
  const box = document.querySelector<HTMLElement>("[data-buy-box]")!;
  const qty = box.querySelector<HTMLElement>("[data-qty-value]")!;
  box.querySelectorAll<HTMLElement>("[data-step]").forEach((b) => b.addEventListener("click", () => {
    const v = Math.max(1, Math.min(20, Number(qty.dataset.value) + Number(b.dataset.step)));
    qty.dataset.value = String(v);
    qty.textContent = bn(v);
  }));
  box.querySelectorAll<HTMLInputElement>('input[name="opt"]').forEach((r) => r.addEventListener("change", () => {
    box.querySelector("[data-price]")!.textContent = `৳${bn(Number(r.dataset.p))}`;
    const was = box.querySelector<HTMLElement>("[data-was]")!;
    was.hidden = !r.dataset.w;
    was.textContent = r.dataset.w ? `৳${bn(Number(r.dataset.w))}` : "";
  }));
</script>
