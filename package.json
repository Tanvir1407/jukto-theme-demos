{
  "name": "jukto-theme-demos",
  "private": true,
  "type": "module",
  "description": "Demo shops for Jukto themes (demo-<theme>.jukto.bd): static snapshots of the real themes. Not connected to the Jukto app: no database, no API, sample data only.",
  "scripts": {
    "seed": "cd ../jukto-code && npx tsx ../jukto-theme-demos/scripts/seed-jukto.ts",
    "snapshot": "node scripts/snapshot.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "images": "node scripts/fetch-images.mjs",
    "build:astro": "node scripts/build-all.mjs",
    "dev:astro": "astro dev"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
